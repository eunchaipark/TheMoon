# .env.example
POSTGRES_DB=news_rag
POSTGRES_USER=news_user
POSTGRES_PASSWORD=your_password
GEMINI_API_KEY=your_gemini_api_key  # Web Agent 전용 (실시간 웹검색)

# Ollama (Router/RAG/Analysis/Summary/Fallback LLM) - Windows Docker: host.docker.internal
# gemma3는 tool-calling 미지원(capabilities: completion만) -> RAG/Analysis 에이전트가 도구 호출 시 400 에러
# tool-calling 지원 모델(qwen2.5, llama3.1 등) 사용 필요
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
LANGCHAIN_API_KEY=your_langsmith_api_key
TAVILY_API_KEY=your_tavily_api_key
AIRFLOW_SECRET_KEY=your_secret_key
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=your_password
AIRFLOW_EMAIL=admin@example.com
EMBED_MODEL=jhgan/ko-sroberta-multitask
LANGCHAIN_PROJECT=TheMoon

# Spark worker resources (optional, defaults shown)
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# Frontend
VITE_API_URL=http://localhost:8000